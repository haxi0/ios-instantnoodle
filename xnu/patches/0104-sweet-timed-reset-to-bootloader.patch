 #define SWEET_DEV_TOUCH_VREG_MV 3200
 #define SWEET_DEV_MARK_PA       0x118000000UL
+/* Reboot-to-bootloader (sweetreset=N): IMEM restart_reason word and PS_HOLD. */
+#define SWEET_DEV_IMEM_RESTART_PA 0x146aa65cu
