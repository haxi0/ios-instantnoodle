 #define SWEET_DEV_USB_ARM_ON_EVENT 0
 #define SWEET_DEV_USB_VBUS_DEFAULT 2
 #define SWEET_DEV_KEYS_VOLUME   1   /* GPIO2 volume-up + PON RESIN volume-down */
