diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 77a9f48..731403c 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -740,17 +740,55 @@ struct sweet_log_header {
 	uint64_t total, seq;
 };
 
+/*
+ * Boot-arg sweetreset=N: N seconds after the log starts, flush the console log once
+ * more and reset the SoC with the bootloader restart reason (as the shim
+ * does), so a host script can boot a recovery and pull the log without
+ * anyone touching the phone. Only from this thread, so the last lines are
+ * on disk first.
+ */
+static uint64_t sweet_reset_at;
+
+static void __attribute__((noreturn))
+sweet_reset_to_bootloader(void)
+{
+	volatile uint32_t *imem = (volatile uint32_t *)ml_io_map(SWEET_DEV_IMEM_RESTART_PA, 4);
+	volatile uint32_t *pshold = (volatile uint32_t *)ml_io_map(SWEET_DEV_PSHOLD_PA, 4);
+
+	if (imem) {
+		*imem = 0x77665500u;    /* bootloader: stay in fastboot */
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	register uint64_t x0 __asm__("x0") = 0x84000009ull;    /* PSCI SYSTEM_RESET */
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	if (pshold) {
+		*pshold = 0;
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
 	uint64_t flushed = 0, seq = 0;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	bool reset_announced = false;
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
 	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
 	for (;;) {
 		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		if (sweet_reset_at && mach_absolute_time() >= sweet_reset_at) {
+			if (reset_announced) {
+				/* The announcement was flushed by the previous pass. */
+				sweet_reset_to_bootloader();
+			}
+			printf("SWEET RESET: sweetreset deadline reached, rebooting to the bootloader after this flush\n");
+			reset_announced = true;
+		}
 		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
 		if (total == flushed) {
 			continue;
@@ -884,6 +922,15 @@ sweet_log_start(void)
 	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
 		sweet_log_secs = SWEET_LOG_SECS;
 	}
+	uint32_t reset_secs = 0;
+	if (PE_parse_boot_argn("sweetreset", &reset_secs, sizeof(reset_secs)) && reset_secs) {
+		/* From now: the arch counter keeps running from the last SoC reset,
+		 * not from this fastboot boot. */
+		uint64_t delta;
+		nanoseconds_to_absolutetime((uint64_t)reset_secs * NSEC_PER_SEC, &delta);
+		sweet_reset_at = mach_absolute_time() + delta;
+		printf("SWEET RESET: reboot to the bootloader in %u s\n", reset_secs);
+	}
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
