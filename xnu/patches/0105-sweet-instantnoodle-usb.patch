+/*
+ * Remote control over USB Ethernet: a UDP datagram "reset" to
+ * 192.168.7.2:5141 (tools/sweet-usbnet.sh reset) flushes the console log
+ * and reboots to the bootloader (bsd/dev/sweet_ufs.c, as sweetreset=N).
+ */
+extern void sweet_reset_request(void);
+
+static void
+ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char buf[64];
+	socket_t so = NULL;
+	struct sockaddr_in me;
+
+	bzero(&me, sizeof(me));
+	me.sin_len = sizeof(me);
+	me.sin_family = AF_INET;
+	me.sin_port = htons(5141);
+	for (;;) {
+		if (so == NULL) {
+			if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+				so = NULL;
+			} else if (sock_bind(so, (struct sockaddr *)&me) != 0) {
+				sock_close(so);
+				so = NULL;
+			}
+			if (so == NULL) {
+				ud_sleep_ms(1000);
+				continue;
+			}
+		}
+		struct iovec iov = { .iov_base = buf, .iov_len = sizeof(buf) - 1 };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t n = 0;
+		if (sock_receive(so, &msg, 0, &n) != 0) {
+			ud_sleep_ms(100);
+			continue;
+		}
+		buf[n] = 0;
+		if (strncmp(buf, "reset", 5) == 0) {
+			printf("SWEET USB: remote reset requested\n");
+			sweet_reset_request();
+		}
+	}
+}
