 #define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
 #define RH_VRM          4u
 #define RH_ARC          3u
+#define RH_BCM          5u      /* bus clock managers (interconnect bandwidth) */
 #define RH_ARC_MAX      32u      /* 16 u16 levels */
 #define RH_TIMEOUT_US   100000u
 
@@ -230,6 +231,52 @@ rh_lookup(const char *res, uint32_t *address)
  * hardware level index to an RPMh voltage corner. Dump the address and table
  * without voting; a vote needs the dependent MX rail and the AOP contract.
  */
+/* A bus clock manager's address in cmd-db (slave 5); exactly one match. */
+static int
+rh_bcm_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0;
+
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		if (slave != RH_BCM) {
+			continue;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY)) {
+			printf("SWEET RPMH: malformed BCM slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (((addr >> 16) & 0xfu) != RH_BCM || (addr & 3u)) {
+				printf("SWEET RPMH: invalid BCM entry for %s (%#x)\n", res, addr);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: BCM %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
