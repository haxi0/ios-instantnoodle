+/*
+ * Memory bandwidth: the most there is on the memory controller (MC0) and the shared hub in
+ * front of it (SH0), and the memory kept on for the CPUs (ACV bit 3), as HackiOS measured:
+ * all cores together 12.4 -> 14.8 GB/s writing, frames over 16.7 ms 34% -> 28%.
+ * BCM word: commit | valid | AB[27:14] | IB[13:0] (Linux icc-bcm-voter.c).
+ */
+#define BCM_COMMIT              (1u << 30)
+#define BCM_VALID               (1u << 29)
+#define BCM_VOTE(x, y)          (BCM_COMMIT | BCM_VALID | ((uint32_t)(x) & 0x3fff) << 14 | ((uint32_t)(y) & 0x3fff))
+#define BCM_ACV_APPS            8
+
+static void
+ddr_raise(void)
+{
+	static const char *const names[3] = { "MC0", "SH0", "ACV" };
+	uint32_t vote = 0x3fff, on = 1, data[3];
+	int error;
+
+	PE_parse_boot_argn("ddr", &on, sizeof(on));
+	PE_parse_boot_argn("ddr_vote", &vote, sizeof(vote));
+	if (!on || vote == 0 || vote > 0x3fff) {
+		printf("SWEET CPUFREQ: no memory bandwidth vote (ddr=%u ddr_vote=%u)\n", on, vote);
+		return;
+	}
+	data[0] = data[1] = BCM_VOTE(vote, vote);
+	data[2] = BCM_VOTE(0, BCM_ACV_APPS);
+	error = sweet_rpmh_bcm_vote(names, data, 3);
+	printf("SWEET CPUFREQ: memory bandwidth vote %u on MC0/SH0 -> %d\n", vote, error);
+}
