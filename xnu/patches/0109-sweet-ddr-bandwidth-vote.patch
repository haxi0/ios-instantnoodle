+/*
+ * Bandwidth votes on bus clock managers (from HackiOS redwood_cpufreq.c ddr_vote(), as
+ * Linux icc-bcm-voter.c casts them): data[i] goes to BCM names[i], up to three in one
+ * ACTIVE TCS. Callers build the BCM words (commit/valid/AB/IB).
+ */
+int sweet_rpmh_bcm_vote(const char *const *names, const uint32_t *data, unsigned count);
+
+int
+sweet_rpmh_bcm_vote(const char *const *names, const uint32_t *data, unsigned count)
+{
+	uint32_t address[3] = {0, 0, 0};
+	int error = EIO;
+
+	if (!names || !data || count == 0 || count > 3) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing BCM vote\n");
+		goto out;
+	}
+	error = rh_map();
+	for (unsigned i = 0; !error && i < count; ++i) {
+		error = rh_bcm_lookup(names[i], &address[i]);
+	}
+	if (!error) {
+		printf("SWEET RPMH: BCM %s=%#x %s=%#x %s=%#x\n", names[0], address[0],
+		    count > 1 ? names[1] : "-", address[1], count > 2 ? names[2] : "-", address[2]);
+		/* rh_send_cmds adds a base address to per-command offsets: base 0, full addresses */
+		error = rh_send_cmds(0, address, data, count, "BCM bandwidth");
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: BCM vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
