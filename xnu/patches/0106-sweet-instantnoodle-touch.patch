- * tiles (pinctrl@f000000) and the second rail. */
+/* Touch: Samsung S6SY761 ("SY771") @0x48 on i2c@a94000 (SE13, live tree
+ * qupv3_se13_i2c_active = gpio36/gpio37, bias-disable), reset tlmm 38, IRQ
+ * tlmm 39, vdd_2v8 pm8150_l13 ("ldoa13", 3.008 V), vcc_1v8 pm8150a_l1
+ * ("ldoc1", 1.8 V); no 1.8 V enable GPIO. sweet_touch_sec.c bit-bangs the
+ * bus as on guacamole. All four pins sit in the SM8250 SOUTH tile
+ * (mainline pinctrl-sm8250.c: west 0xf100000, south 0xf500000, north
+ * 0xf900000; pins at tile + 0x1000 * gpio). */
 #define SWEET_DEV_TOUCH         0
-#define SWEET_DEV_TOUCH_SEC     0
+#define SWEET_DEV_TOUCH_SEC     1
 #define SWEET_DEV_TOUCH_VREG_NAME "ldoa13"
 #define SWEET_DEV_TOUCH_VREG_MV 3008
+#define SWEET_DEV_TOUCH_VREG2_NAME "ldoc1"
+#define SWEET_DEV_TOUCH_VREG2_MV 1800
+#define SWEET_DEV_TOUCH_TLMM_TILE_PA 0x0f500000u
+#define SWEET_DEV_TOUCH_PIN_RESET 38u
+#define SWEET_DEV_TOUCH_PIN_IRQ   39u
+#define SWEET_DEV_TOUCH_PIN_I2C_A 36u
+#define SWEET_DEV_TOUCH_PIN_I2C_B 37u
+/* cmd-db: reserved-memory@80860000 (qcom,cmd-db, 0x20000) in the live tree. */
+#define SWEET_DEV_RPMH_DB_PA    0x80860000u
+#define SWEET_DEV_RPMH_DB_SIZE  0x20000u
 
