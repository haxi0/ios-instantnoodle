diff --git a/pexpert/pexpert/arm64/INSTANTNOODLE.h b/pexpert/pexpert/arm64/INSTANTNOODLE.h
new file mode 100644
index 0000000..0ee9c4a
--- /dev/null
+++ b/pexpert/pexpert/arm64/INSTANTNOODLE.h
@@ -0,0 +1,83 @@
+/*
+ * Board config for the OnePlus 8 ("instantnoodle", Qualcomm SM8250 /
+ * Snapdragon 865): Kryo 585 = 4x Cortex-A55 + 4x Cortex-A77, ARMv8.2,
+ * no PAC. Same platform class as sweet (SM7150): generic ARM, 16K pages,
+ * GICv3 with two security states (every interrupt, including the timer,
+ * is a Group 1 IRQ taken through sleh_irq()).
+ *
+ * Per-device addresses (framebuffer, SPMI, RPMh, USB) live in
+ * pexpert/pexpert/arm64/sweet_dev.h, not here.
+ */
+
+#ifndef _PEXPERT_ARM64_INSTANTNOODLE_H
+#define _PEXPERT_ARM64_INSTANTNOODLE_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define SWEET                     1
+
+/*
+ * All eight cores (four A55 + four A77, Kryo 585) as one homogeneous SMP
+ * cluster: cpus=N is clamped here. PSCI CPU_ON, 64-byte lines; the
+ * scheduler does not know the A77s are faster (no AMP/P-E clusters yet).
+ */
+#define SWEET_SMP_MAX_CPUS         8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * SM8250 uses the standard PPI numbering (arm,armv8-timer <1 13>, <1 14>,
+ * <1 11>, <1 12>), unlike SM7150/SM8150's Qualcomm numbering: the virtual
+ * timer XNU uses (CNTV) is PPI 11 = INTID 27. The ADT's virtual-timer-intid
+ * overrides this default (pexpert/arm/pe_fiq.c); both must say 27.
+ */
+#define SWEET_VTIMER_INTID        27
+#define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_INSTANTNOODLE_H */
