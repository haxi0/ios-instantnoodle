diff --git a/pexpert/pexpert/arm64/sweet_dev.h b/pexpert/pexpert/arm64/sweet_dev.h
index 0b7870b..283bcfc 100644
--- a/pexpert/pexpert/arm64/sweet_dev.h
+++ b/pexpert/pexpert/arm64/sweet_dev.h
@@ -5,6 +5,7 @@
  * Per-device hardware constants for the sweet XNU port.
  *
  * One block per board, selected by the machine config:
+ *   INSTANTNOODLE  OnePlus 8 (SM8250):  -DARM64_BOARD_CONFIG_INSTANTNOODLE
  *   GUACAMOLE  OnePlus 7 Pro (SM8150):  -DARM64_BOARD_CONFIG_GUACAMOLE
  *   SWEET      Redmi Note 10 Pro (SM7150): default
  *
@@ -19,7 +20,69 @@
  * "sweet port", not "sweet phone": per-board numbers live here.
  */
 
-#if defined(ARM64_BOARD_CONFIG_GUACAMOLE)
+#if defined(ARM64_BOARD_CONFIG_INSTANTNOODLE)
+
+/* ------------- OnePlus 8 (instantnoodle, SM8250) ------------- */
+
+/* Values from the IN2010's own live FDT (2026-10-21, INSTANTNOODLE.md);
+ * tools/fdt-audit.py --device instantnoodle checks them. */
+#define SWEET_DEV_NAME          "instantnoodle"
+
+/* ABL continuous-splash framebuffer: cont_splash_region 0x9c000000 +
+ * 0x02300000. Panel: Samsung ana6705, 1080x2400 DSC cmd mode, a8r8g8b8. */
+#define SWEET_DEV_FB_PA         0x9c000000UL
+#define SWEET_DEV_FB_W          1080
+#define SWEET_DEV_FB_H          2400
+#define SWEET_DEV_FB_STRIDE     (SWEET_DEV_FB_W * 4)
+
+/* SPMI arbiter at 0xc440000, same regs as SM8150. PM8150 is SID 0 (PON at
+ * 0x800, gpio-keys on its GPIO block at 0xc000). */
+#define SWEET_DEV_SPMI_CORE_PA  0x0c440000u
+#define SWEET_DEV_SPMI_OBS_PA   0x0e600000u
+#define SWEET_DEV_SPMI_CFG_PA   0x0c40a000u
+#define SWEET_DEV_PON_RT        0x0810u          /* PON RT_STS (PON base 0x800 + 0x10) */
+
+/* Keys: gpio-keys in the live tree are PM8150 GPIO6 (volume up) and GPIO7
+ * (volume down), active low - the guacamole layout. The driver checks the
+ * pin config ABL left behind and withholds an unconfigured pin. */
+#define SWEET_DEV_KEYS_VOLUME   1
+#define SWEET_DEV_VOL_GPIO_RT   0xc510u         /* volume up: PM8150 GPIO6 */
+#define SWEET_DEV_VOL_GPIO2_RT  0xc610u         /* volume down: PM8150 GPIO7 */
+#define SWEET_DEV_VOL_GPIO_SID  0               /* PM8150 */
+#define SWEET_DEV_VOL_DOWN_PON  0               /* volume-down is a GPIO here */
+
+/* RPMh: rsc@18200000 "apps_rsc", qcom,drv-id 2 -> DRV-2 at 0x18220000,
+ * qcom,tcs-offset 0xd00. The command DB is reserved-memory@80860000 in the
+ * live tree; the AOP locator word at 0xc3f000c is assumed as on SM8150 and
+ * is only read by the touch rail vote (VERIFY before touch bring-up). */
+#define SWEET_DEV_RPMH_RSC_PA   0x18220000u
+#define SWEET_DEV_RPMH_TCS_PA   0x18220d00u
+#define SWEET_DEV_RPMH_TCS_SIZE 0x3000u
+#define SWEET_DEV_RPMH_DICT_PA  0x0c3f000cu      /* VERIFY */
+
+/* Touch: Samsung S6SY761 ("SY771") @0x48 on i2c@a94000, reset tlmm 38,
+ * IRQ tlmm 39, vdd pm8150_l13 ("ldoa13", 3.008 V), vcc pm8150a_l1
+ * ("ldoc1", 1.8 V). Off until sweet_touch_sec.c learns the SM8250 TLMM
+ * tiles (pinctrl@f000000) and the second rail. */
+#define SWEET_DEV_TOUCH         0
+#define SWEET_DEV_TOUCH_SEC     0
+#define SWEET_DEV_TOUCH_VREG_NAME "ldoa13"
+#define SWEET_DEV_TOUCH_VREG_MV 3008
+
+/* USB: usb0 = dwc3@a600000, HS PHY hsphy@88e3000 (not 0x88e2000 as on
+ * SM8150), QMP ssphy@88e8000. Off until the SM8250 GCC offsets are filled
+ * in; sweet_usb.c compiles out. */
+#define SWEET_DEV_USB           0
+#define SWEET_DEV_USB_ARM_ON_EVENT 1
+#define SWEET_DEV_USB_VBUS_DEFAULT 3
+/* Reset-surviving scratch (DRAM, kernel high bank 0x180000000 + 0x18000000). */
+#define SWEET_DEV_MARK_PA       0x198000000UL
+
+/* Panel physical size in mm (ana6705 node: 70 x 151). */
+#define SWEET_DEV_PANEL_MM_W    70
+#define SWEET_DEV_PANEL_MM_H    151
+
+#elif defined(ARM64_BOARD_CONFIG_GUACAMOLE)
 
 /* ------------- OnePlus 7 Pro (guacamole, SM8150) ------------- */
 
@@ -119,7 +182,7 @@
 #define SWEET_DEV_PANEL_MM_W    76
 #define SWEET_DEV_PANEL_MM_H    163
 
-#else /* !ARM64_BOARD_CONFIG_GUACAMOLE -> sweet */
+#else /* neither INSTANTNOODLE nor GUACAMOLE -> sweet */
 
